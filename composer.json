{
    "name": "jonaplaz/aidd-level",
    "description": "Evaluates the AI-Driven Development level of a developer profile",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "symfony/console": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13",
        "phpstan/phpstan": "^2",
        "friendsofphp/php-cs-fixer": "^3",
        "systemsdk/phpcpd": "^9"
    },
    "autoload": {
        "psr-4": { "AiddLevel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "AiddLevel\\Tests\\": "tests/" }
    },
    "bin": ["bin/aidd-level"],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
